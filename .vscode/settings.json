{
  "zig.path": "${env:HOME}/.local/tools/zig-latest/zig",
  "zig.zls.enabled": "on",
  "zig.testArgs": [
    "build",
    "test",
    "-Dtest-filter=${filter}"
  ],
  "zig.debugTestArgs": [
    "build",
    "debug-test",
    "-Dtest-filter=${filter}"
  ],
  "java.project.sourcePaths": [
    "src/android/bootstrap",
    "src/android/test"
  ],
  "java.project.referencedLibraries": [
    "${env:ANDROID_HOME}/platforms/android-37.2/android.jar",
    "third_party/androidx-test/*.jar",
    "zig-out/android-test/jars/*/classes.jar"
  ]
}
